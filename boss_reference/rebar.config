%% Rebar3-native configuration for the Chicago Boss reference application.
%% The legacy source layout is intentional; the Chicago Boss project provider
%% compiles it once through boss_load after Rebar3 has built the dependencies.

%% MochiWeb v3.5.0 is the current pinned release and requires OTP 23 or newer.
{minimum_otp_vsn, "23.0"}.

{src_dirs, ["src/boss"]}.

{project_plugins, [
    {chicago_boss_rebar3,
     {git_subdir, "https://github.com/rlander/ChicagoBoss.git",
                  {ref, "bd5c7d8f8735d04102e7f300c146b524273d25bb"},
                  "priv/rebar3/chicago_boss_rebar3"}}
]}.

{provider_hooks, [
    {post, [{compile, chicago_boss_compile}]}
]}.

%% Keep the verified dependency revisions from the Chicago Boss OTP-21
%% baseline. The Boss source revision is pinned separately from the provider;
%% it must be published before an external checkout can resolve this app.
{deps, [
    {boss, {git, "https://github.com/rlander/ChicagoBoss.git",
                  {ref, "bd5c7d8f8735d04102e7f300c146b524273d25bb"}}},
    {boss_db, {git, "https://github.com/rlander/boss_db.git",
                       {ref, "265a567829b27382bbbf84389e1a7c24cc4184a1"}}},
    {tinymq, {git, "https://github.com/ChicagoBoss/tinymq.git",
                      {ref, "12fc8472442a46bc7130847625a68be33f88f181"}}},
    %% ErlyDTL 0.15.0; not released on Hex
    {erlydtl, {git, "https://github.com/erlydtl/erlydtl.git",
                        {ref, "aae414692b6052e96d890e03bbeeeca0f4dc01c2"}}},
    {jaderl, {git, "https://github.com/erlydtl/jaderl.git",
                      {ref, "14a80dafd92037d041dd352466fc3ddef5ae091e"}}},
    {gen_smtp, "1.3.0"},
    {iso8601, "1.4.0"},
    {mimetypes, "1.1.0"},
    {mochiweb, "3.5.0"},
    {cowboy, "2.20.0"},
    {simple_bridge, "2.3.2"},
    {cowlib, "2.21.0"},
    {ranch, "1.8.1"},
    {dynamic_compile, {git, "https://github.com/JacobVorreuter/dynamic_compile.git",
                                   {ref, "6a165715178dae8ea1c72e6ef171b9fc3435badc"}}},
    {goldrush, "0.1.9"},
    %% The Boss compiler includes Proper headers during normal compilation.
    {proper, "1.5.0"},
    {poolboy, "1.5.2"},
    {lager, "3.9.2"},
    {pmod_transform, "1.1.0"},
    {stacktrace_compat, "1.2.2"}
]}.

%% OTP 21 does not perform the tuple-call rewrite that the historical
%% ErlyDTL runtime expects when it invokes BossRecord values. This is a
%% compiler option, not a source fork or dependency revision change.
{overrides, [
    {override, erlydtl, [{erl_opts, [debug_info, tuple_calls]}]},
    %% OTP 29 warns on ibrowse's legacy bare catch expressions. ibrowse
    %% promotes compiler warnings to errors, so suppress only this known
    %% syntax warning while retaining its other warning checks.
    {override, ibrowse, [{erl_opts, [
        debug_info,
        warnings_as_errors,
        warn_unused_vars,
        nowarn_shadow_vars,
        warn_unused_import,
        nowarn_deprecated_catch,
        {platform_define, "18|19|^2", new_rand},
        {platform_define, "^2", ets_ref}
    ]}]},
    %% Keep the historical Erlando API while rewriting its removed
    %% get_stacktrace/0 call for OTP 25.
    {override, erlando, [{erl_opts, [
        debug_info,
        warnings_as_errors,
        {parse_transform, do},
        {parse_transform, stacktrace_transform}
    ]}]},
    {override, boss_db, [{erl_opts, [
        debug_info,
        warn_unused_vars,
        warn_unused_import,
        warn_exported_vars,
        {parse_transform, lager_transform},
        {parse_transform, cut},
        {parse_transform, do},
        {parse_transform, import_as},
        {parse_transform, chicago_boss_pmod_pt}
    ]}]}
]}.

{erl_opts, [debug_info, {parse_transform, chicago_boss_pmod_pt}]}.

%% The historical mimetypes application materializes its dispatch and mapping
%% modules when it starts.  Rebar2 happened to leave these generated beams in
%% the dependency checkout; make that step explicit in the Rebar3 compile
%% workflow so a clean checkout can also be packaged and booted.
{post_hooks, [
    %% ../priv/rebar3/reloader.erl is a copy of MochiWeb's reloader.erl with
    %% the small change needed by this development workflow. Compile it here,
    %% after MochiWeb has been built, so it replaces MochiWeb's reloader beam.
    {compile,
        "sh -c 'for d in _build/*/lib/mochiweb/ebin; do "
        "if test -d \"$d\"; then "
        "erlc -o \"$d\" ../priv/rebar3/reloader.erl || exit 1; "
        "fi; done'"},
    {compile,
        "sh -c 'for d in _build/*/lib/mimetypes/ebin; do "
        "if test -d \"$d\"; then "
        "rm -f \"$d/mimetypes_disp.beam\" \"$d/mimetypes_map.beam\"; "
        "erl -noshell -pa \"$d\" "
        "-eval \"case application:start(mimetypes) of "
        "ok -> application:stop(mimetypes), "
        "F=filename:join(filename:dirname(code:which(mimetypes_app)), \\\"mimetypes.app\\\"), "
        "{ok,[{application,mimetypes,P}]}=file:consult(F), "
        "M=proplists:get_value(modules,P,[]), "
        "P1=lists:keystore(modules,1,P,{modules,lists:usort(M++[mimetypes_disp,mimetypes_map])}), "
        "ok=file:write_file(F,io_lib:format(\\\"{application, mimetypes, ~p}.~n\\\",[P1])), "
        "halt(0); "
        "Error -> io:format(\\\"mimetypes bootstrap failed: ~p~n\\\", [Error]), halt(1) "
        "end.\" || exit 1; "
        "fi; done'"}
]}.

{profiles, [
    {test, [
        {eunit_opts, [verbose, {dir, "test"}]},
        {ct_opts, [{dir, "ct"}]}
    ]},
    {dev, []},
    {prod, []}
]}.

{shell, [
    %% Development shell configuration sets boss.developing_app. boss_app
    %% starts MochiWeb's reloader; Rebar3 3.28.0 does not consume vm_args.
    {config, "config/sys.dev.config"},
    {vm_args, "config/vm.dev.args"},
    {apps, [boss_reference]}
]}.

{relx, [
    {release, {boss_reference, "0.0.1"}, [
        boss_reference, boss, boss_db, tinymq, erlydtl, jaderl, gen_smtp,
        iso8601, mimetypes, mochiweb, cowboy, simple_bridge, cowlib, ranch,
        dynamic_compile, goldrush, stacktrace_compat,
        aleppo, ddb, dh_date, epgsql, erlando, ets_cache, ibrowse,
        jsx, lager, mysql, poolboy, redo, tiny_pq, uuid, sasl
    ]},
    {overlay, [
        {copy, "_build/default/lib/mimetypes/ebin/mimetypes_disp.beam",
               "lib/mimetypes-1.1.0+build.58.refee98c76/ebin/mimetypes_disp.beam"},
        {copy, "_build/default/lib/mimetypes/ebin/mimetypes_map.beam",
               "lib/mimetypes-1.1.0+build.58.refee98c76/ebin/mimetypes_map.beam"}
    ]},
    {mode, prod}
]}.
