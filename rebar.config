%% -*- mode: erlang;erlang-indent-level: 4;indent-tabs-mode: nil -*-
%% Canonical Rebar3 configuration for the OTP 28.5.0.8 toolchain. The legacy
%% source compatibility layer is retained, but the current MochiWeb v3.5.0
%% dependency declares OTP 23 as its minimum supported release.

{minimum_otp_vsn, "23.0"}.

%% The framework itself is compiled by Rebar3 from src/boss.  Legacy
%% application directories are compiled by the post-compile Chicago Boss
%% provider, which preserves parameterized controllers, BossRecord models,
%% ErlyDTL views, route metadata and generated application metadata.
{src_dirs, ["src"]}.

{project_plugins, [
    {chicago_boss_rebar3,
     {git_subdir, "https://github.com/rlander/ChicagoBoss.git",
                  {ref, "bd5c7d8f8735d04102e7f300c146b524273d25bb"},
                  "priv/rebar3/chicago_boss_rebar3"}}
]}.

{provider_hooks, [
    {post, [{compile, chicago_boss_compile}]}
]}.

%% OTP 21 removed the native tuple-call expansion used by Chicago Boss and
%% boss_db. Apply the compatibility transform to those dependency builds too;
%% the legacy source compilers still apply their own boss_db transforms to
%% generated controllers and records.
{overrides, [
    {override, erlydtl, [{erl_opts, [debug_info, tuple_calls]}]},
    %% OTP 29 warns on ibrowse's legacy bare catch expressions. ibrowse
    %% promotes compiler warnings to errors, so suppress only this known
    %% syntax warning while retaining its other warning checks.
    {override, ibrowse, [{erl_opts, [
        debug_info,
        warnings_as_errors,
        warn_unused_vars,
        nowarn_shadow_vars,
        warn_unused_import,
        nowarn_deprecated_catch,
        {platform_define, "18|19|^2", new_rand},
        {platform_define, "^2", ets_ref}
    ]}]},
    %% Erlando's historical test helper still calls get_stacktrace/0. Keep
    %% the legacy Erlando revision and rewrite that call during compilation
    %% using the already-locked stacktrace_compat dependency.
    {override, erlando, [{erl_opts, [
        debug_info,
        warnings_as_errors,
        {parse_transform, do},
        {parse_transform, stacktrace_transform}
    ]}]},
    {override, boss_db, [{erl_opts, [
        debug_info,
        warn_unused_vars,
        warn_unused_import,
        warn_exported_vars,
        {parse_transform, lager_transform},
        {parse_transform, cut},
        {parse_transform, do},
        {parse_transform, import_as},
        {parse_transform, chicago_boss_pmod_pt}
    ]}]}
]}.

{erl_opts, [
    debug_info,
    warn_unused_vars,
    warn_unused_import,
    warn_exported_vars,
    {parse_transform, lager_transform},
    {parse_transform, cut},
    {parse_transform, do},
    {parse_transform, import_as},
    {parse_transform, pmod_pt}
]}.

%% The historical mimetypes application generates its dispatch and mapping
%% modules on first start.  Rebar 2's build path happened to materialize them
%% before packaging; keep that behavior in the canonical Rebar3 workflow.
{post_hooks, [
    %% priv/rebar3/reloader.erl is a copy of MochiWeb's reloader.erl with the
    %% small change needed by this development workflow. Compile it here,
    %% after MochiWeb has been built, so it replaces MochiWeb's reloader beam.
    {compile,
        "sh -c 'for d in _build/*/lib/mochiweb/ebin; do "
        "if test -d \"$d\"; then "
        "erlc -o \"$d\" priv/rebar3/reloader.erl || exit 1; "
        "fi; done'"},
    {compile,
        "sh -c 'for d in _build/*/lib/mimetypes/ebin; do "
        "if test -d \"$d\"; then "
        "erl -noshell -pa \"$d\" "
        "-eval \"case application:start(mimetypes) of "
        "ok -> application:stop(mimetypes), "
        "F=filename:join(filename:dirname(code:which(mimetypes_app)), \\\"mimetypes.app\\\"), "
        "{ok,[{application,mimetypes,P}]}=file:consult(F), "
        "M=proplists:get_value(modules,P,[]), "
        "P1=lists:keystore(modules,1,P,{modules,lists:usort(M++[mimetypes_disp,mimetypes_map])}), "
        "ok=file:write_file(F,io_lib:format(\\\"{application, mimetypes, ~p}.~n\\\",[P1])), "
        "halt(0); "
        "Error -> io:format(\\\"mimetypes bootstrap failed: ~p~n\\\", [Error]), halt(1) "
        "end.\" || exit 1; "
        "fi; done'"}
]}.

{deps, [
    {boss_db, {git, "https://github.com/rlander/boss_db.git",
                       {ref, "265a567829b27382bbbf84389e1a7c24cc4184a1"}}},
    {tinymq, {git, "https://github.com/ChicagoBoss/tinymq.git",
                      {ref, "12fc8472442a46bc7130847625a68be33f88f181"}}},
    %% ErlyDTL 0.15.0; not released on Hex
    {erlydtl, {git, "https://github.com/erlydtl/erlydtl.git",
                        {ref, "aae414692b6052e96d890e03bbeeeca0f4dc01c2"}}},
    {jaderl, {git, "https://github.com/erlydtl/jaderl.git",
                      {ref, "14a80dafd92037d041dd352466fc3ddef5ae091e"}}},
    {gen_smtp, "1.3.0"},
    {iso8601, "1.4.0"},
    {mimetypes, "1.1.0"},
    {mochiweb, "3.5.0"},
    {cowboy, "2.20.0"},
    {simple_bridge, "2.3.2"},

    {cowlib, "2.21.0"},
    {ranch, "1.8.1"},
    {dynamic_compile, {git, "https://github.com/JacobVorreuter/dynamic_compile.git",
                                   {ref, "6a165715178dae8ea1c72e6ef171b9fc3435badc"}}},
    {goldrush, "0.1.9"},

    %% ChicagoBoss includes Proper headers in production modules, so this
    %% remains a normal compile dependency rather than a test-only dependency.
    {proper, "1.5.0"},
    {poolboy, "1.5.2"},

    %% These direct declarations override active transitive legacy Git
    %% declarations with published Hex packages while preserving the public
    %% dependency APIs. Lager 3.9.2 is used instead of the older transitive
    %% release because it supports the newer OTP annotation tuples.
    {lager, "3.9.2"},
    {pmod_transform, "1.1.0"},
    {stacktrace_compat, "1.2.2"}
]}.

{profiles, [
    {test, [
        {deps, [
            {boss_test, {git, "https://github.com/ChicagoBoss/boss_test.git",
                                 {ref, "904bdc47c87d73a891ff86b96f7a3cefd3e5c632"}}}
        ]},
        {ct_opts, [{dir, "ct"}]},
        {eunit_opts, [verbose]}
    ]},
    {dev, []},
    {prod, []}
]}.

{relx, [
    %% The historical boss.app.src predates Rebar3 and lists only OTP
    %% applications.  Keep the release closure explicit so Relx packages the
    %% runtime dependencies that Chicago Boss starts dynamically.
    {release, {chicagoboss, "0.9.0"}, [
        kernel, stdlib, sasl, crypto, mnesia, edoc, eunit,
        boss, boss_db, tinymq, erlydtl, jaderl, gen_smtp, iso8601,
        mimetypes, mochiweb, cowboy, simple_bridge, cowlib, ranch,
        dynamic_compile, goldrush, stacktrace_compat,
        aleppo, ddb, dh_date, epgsql, erlando, ets_cache, ibrowse,
        jsx, lager, mysql, poolboy, redo, tiny_pq, uuid
    ]},
    %% mimetypes generates these modules at compile time, but its historical
    %% .app.src cannot list them.  Copy the generated artifacts into a Relx
    %% package so a release does not depend on the source checkout.
    {overlay, [
        {copy, "_build/default/lib/mimetypes/ebin/mimetypes_disp.beam",
               "lib/mimetypes-1.1.0+build.58.refee98c76/ebin/mimetypes_disp.beam"},
        {copy, "_build/default/lib/mimetypes/ebin/mimetypes_map.beam",
               "lib/mimetypes-1.1.0+build.58.refee98c76/ebin/mimetypes_map.beam"}
    ]},
    {mode, prod},
    {extended_start_script, true}
]}.
