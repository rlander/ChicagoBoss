%% MochiWeb v3.5.0 is the current pinned release and requires OTP 23 or newer.
{minimum_otp_vsn, "23.0"}.

%% Keep the normal Rebar3 compiler away from legacy Chicago Boss application
%% directories.  The post-compile provider invokes the historical pipeline
%% once, after the Boss dependency has been built.
{src_dirs, ["src/boss"]}.

{project_plugins, [
    {chicago_boss_rebar3,
     {git_subdir, "https://github.com/rlander/ChicagoBoss.git",
                  {ref, "bd5c7d8f8735d04102e7f300c146b524273d25bb"},
                  "priv/rebar3/chicago_boss_rebar3"}}
]}.

{provider_hooks, [
    {post, [{compile, chicago_boss_compile}]}
]}.

{overrides, [
    {override, erlydtl, [{erl_opts, [debug_info, tuple_calls]}]},
    %% OTP 29 warns on ibrowse's legacy bare catch expressions. ibrowse
    %% promotes compiler warnings to errors, so suppress only this known
    %% syntax warning while retaining its other warning checks.
    {override, ibrowse, [{erl_opts, [
        debug_info,
        warnings_as_errors,
        warn_unused_vars,
        nowarn_shadow_vars,
        warn_unused_import,
        nowarn_deprecated_catch,
        {platform_define, "18|19|^2", new_rand},
        {platform_define, "^2", ets_ref}
    ]}]},
    %% Compile the historical Erlando test helper on OTP 25 without changing
    %% its legacy do/cut API.
    {override, erlando, [{erl_opts, [
        debug_info,
        warnings_as_errors,
        {parse_transform, do},
        {parse_transform, stacktrace_transform}
    ]}]},
    {override, boss_db, [{erl_opts, [
        debug_info,
        warn_unused_vars,
        warn_unused_import,
        warn_exported_vars,
        {parse_transform, lager_transform},
        {parse_transform, cut},
        {parse_transform, do},
        {parse_transform, import_as},
        {parse_transform, chicago_boss_pmod_pt}
    ]}]}
]}.

{erl_opts, [debug_info, {parse_transform, chicago_boss_pmod_pt}]}.

%% Rebar 3 must materialize mimetypes' generated dispatch modules before a
%% release is assembled; this is the dependency's historical startup step.
{post_hooks, [
    %% priv/rebar3/reloader.erl is a copy of MochiWeb's reloader.erl with the
    %% small change needed by this development workflow. Compile it here,
    %% after MochiWeb has been built, so it replaces MochiWeb's reloader beam.
    {compile,
        "sh -c 'for d in _build/*/lib/mochiweb/ebin; do "
        "if test -d \"$d\"; then "
        "erlc -o \"$d\" priv/rebar3/reloader.erl || exit 1; "
        "fi; done'"},
    {compile,
        "sh -c 'for d in _build/*/lib/mimetypes/ebin; do "
        "if test -d \"$d\"; then "
        "erl -noshell -pa \"$d\" "
        "-eval \"case application:start(mimetypes) of "
        "ok -> application:stop(mimetypes), "
        "F=filename:join(filename:dirname(code:which(mimetypes_app)), \\\"mimetypes.app\\\"), "
        "{ok,[{application,mimetypes,P}]}=file:consult(F), "
        "M=proplists:get_value(modules,P,[]), "
        "P1=lists:keystore(modules,1,P,{modules,lists:usort(M++[mimetypes_disp,mimetypes_map])}), "
        "ok=file:write_file(F,io_lib:format(\\\"{application, mimetypes, ~p}.~n\\\",[P1])), "
        "halt(0); "
        "Error -> io:format(\\\"mimetypes bootstrap failed: ~p~n\\\", [Error]), halt(1) "
        "end.\" || exit 1; "
        "fi; done'"}
]}.

%% The generated application has a locked, exact Boss dependency.  The
%% boss_url and boss_ref template variables permit an isolated validation run
%% to use a local mirror of the same immutable Git revision.
{deps, [
    {boss, {git, "{{boss_url}}", {ref, "{{boss_ref}}"}}},
    {boss_db, {git, "https://github.com/rlander/boss_db.git",
                       {ref, "265a567829b27382bbbf84389e1a7c24cc4184a1"}}},
    {tinymq, {git, "https://github.com/ChicagoBoss/tinymq.git",
                      {ref, "12fc8472442a46bc7130847625a68be33f88f181"}}},
    {erlydtl, {git, "https://github.com/erlydtl/erlydtl.git",
                        {ref, "118c176f61a0c466516c30502a1498ae3c40b545"}}},
    {jaderl, {git, "https://github.com/erlydtl/jaderl.git",
                      {ref, "14a80dafd92037d041dd352466fc3ddef5ae091e"}}},
    %% gen_smtp 1.3.0 is the current upstream release.  It retains the
    %% gen_smtp_client API and uses the already-pinned Ranch dependency for
    %% incoming SMTP listeners.
    {gen_smtp, "1.3.0"},
    {iso8601, "1.4.0"},
    {mimetypes, "1.1.0"},
    {mochiweb, "3.5.0"},
    {cowboy, "2.20.0"},
    {simple_bridge, "2.3.2"},
    {cowlib, "2.21.0"},
    {ranch, "1.8.1"},
    {dynamic_compile, {git, "https://github.com/JacobVorreuter/dynamic_compile.git",
                                   {ref, "6a165715178dae8ea1c72e6ef171b9fc3435badc"}}},
    {goldrush, "0.1.9"},
    {proper, {git, "https://github.com/manopapad/proper.git",
                      {ref, "f2b7b81666b21707244a40857cf50f4362b6e3c2"}}},
    {poolboy, "1.5.2"},
    {lager, "3.9.2"},
    {pmod_transform, {git, "https://github.com/erlang/pmod_transform.git",
                                  {ref, "f96b8b572395581d58fe3dd7c3e61f3f0e8fa6dc"}}},
    {stacktrace_compat, {git, "https://github.com/g-andrade/stacktrace_compat",
                                     {ref, "fe6238499a216f6f94836be9ec0b3956ea5c6101"}}}
]}.

{profiles, [
    {test, [
        {eunit_opts, [verbose]},
        {ct_opts, [{dir, "ct"}]}
    ]}
]}.

{shell, [
    %% The shell is the development workflow. boss_app starts reloader when
    %% this sys config sets developing_app; Rebar3 3.28.0 does not consume the
    %% vm_args key, so vm.dev.args is retained for alternate launchers only.
    {config, "config/sys.dev.config"},
    {vm_args, "config/vm.dev.args"},
    {apps, [{{name}}]}
]}.

{relx, [
    %% boss starts Lager dynamically; include it explicitly because the
    %% historical boss.app does not declare it as an OTP application.
    %% The remaining entries are also dynamically loaded by Chicago Boss or
    %% by its adapters.  Keeping the closure explicit makes a generated
    %% release self-contained instead of depending on the build tree.
    {release, { {{name}}, "0.1.0"}, [
        {{name}}, boss, boss_db, tinymq, erlydtl, jaderl, gen_smtp,
        iso8601, mimetypes, mochiweb, cowboy, simple_bridge, cowlib, ranch,
        dynamic_compile, goldrush, stacktrace_compat,
        aleppo, ddb, dh_date, epgsql, erlando, ets_cache, ibrowse,
        jsx, lager, mysql, poolboy, redo, tiny_pq, uuid, sasl
    ]},
    %% mimetypes generates these modules at compile time, but its historical
    %% .app.src cannot list them.  Copy them into generated releases.
    {overlay, [
        {copy, "_build/default/lib/mimetypes/ebin/mimetypes_disp.beam",
               "lib/mimetypes-1.1.0+build.58.refee98c76/ebin/mimetypes_disp.beam"},
        {copy, "_build/default/lib/mimetypes/ebin/mimetypes_map.beam",
               "lib/mimetypes-1.1.0+build.58.refee98c76/ebin/mimetypes_map.beam"}
    ]},
    {mode, prod},
    {extended_start_script, true}
]}.
